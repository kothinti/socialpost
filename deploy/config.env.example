# Copy to deploy/config.env and edit before running install.sh
#
# cp deploy/config.env.example deploy/config.env

# Linux user that owns and runs the app (your SSH login user is fine)
DEPLOY_USER=

# Absolute path where the repo will live (e.g. /home/you/socialpost)
APP_DIR=

# Public URL — DNS: DigitalOcean → kennethmonfort.com → A record "socialpost" → droplet IP
DOMAIN=socialpost.kennethmonfort.com

# Internal port for Next.js (only proxied by nginx; pick a free port if 3000 is taken)
APP_PORT=3000

# Git source — use SSH on the server (recommended) or HTTPS + a GitHub PAT (not your password)
# SSH:   git@github.com:kothinti/socialpost.git
# HTTPS: https://github.com/kothinti/socialpost.git
GIT_REPO=git@github.com:kothinti/socialpost.git
GIT_BRANCH=x-ai-reply-scheduler

# Daily cron schedule (minute hour dom month dow)
CRON_SCHEDULE=0 9 * * *
