# Session signing secret (change in production)
AUTH_SECRET=replace-with-a-long-random-string

# Shared secret for unattended cron (Authorization: Bearer …)
CRON_SECRET=replace-with-another-long-random-string

# Used by npm run cron
APP_URL=http://localhost:3000

# MongoDB connection string (required)
# Example Atlas: mongodb+srv://USER:PASS@cluster.xxxxx.mongodb.net/socialpost?retryWrites=true&w=majority
# In Atlas → Network Access, allow 0.0.0.0/0 for Vercel serverless.
MONGODB_URI=mongodb://127.0.0.1:27017/socialpost

# Optional DB name override if not present in the URI path
# MONGODB_DB=socialpost
